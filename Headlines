<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Headlines from 2028</title>
<meta name="description" content="Headlines partners wrote at Session 4 of the Workforce Ecosystem Design Series, October 20, 2026.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400..900;1,400&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#161a4f;--navy-deep:#0f1238;--teal:#0f7f86;--teal-light:#8fe0d9;--teal-soft:#e4f2f1;
  --paper:#fafbfc;--mist:#eef0f6;--ink:#1d2040;--muted:#5a5f80;--line:#dadded;
  --font:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif;
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font);font-size:1.0625rem;line-height:1.6}
a:focus-visible{outline:3px solid var(--teal);outline-offset:3px;border-radius:4px}
.wrap{max-width:980px;margin:0 auto;padding:0 24px}
p{margin:0 0 1em;max-width:66ch}

/* Top bar */
.top{background:var(--navy);padding:18px 0}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px}
.top img{width:150px;height:auto;display:block}
.back{color:#dfe2f6;font-weight:600;font-size:.95rem;text-decoration:none;white-space:nowrap}
.back:hover{color:#fff;text-decoration:underline;text-underline-offset:3px}

/* Masthead */
.masthead{padding:48px 0 0}
.masthead .rule{border-top:6px solid var(--navy);border-bottom:1px solid var(--navy);height:10px}
.masthead h1{font-weight:900;font-size:clamp(2.6rem,9vw,5.6rem);line-height:.95;letter-spacing:-.035em;color:var(--navy);margin:18px 0 14px;text-align:center}
.dateline{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-top:1px solid var(--navy);border-bottom:3px solid var(--navy);padding:8px 0;font-weight:600;font-size:.92rem;color:var(--muted)}
.intro{padding:28px 0 8px}
.intro p{font-size:1.12rem}

/* Lead */
.lead{padding:16px 0 40px}
.lead-card{background:var(--navy);color:#fff;border-radius:16px;padding:40px 36px;position:relative;overflow:hidden}
.lead-card::after{content:"";position:absolute;right:-90px;bottom:-140px;width:320px;height:320px;border-radius:50%;border:44px solid var(--teal);opacity:.35}
.lead-card .tag{display:inline-block;background:var(--teal-light);color:var(--navy);font-weight:700;font-size:.85rem;border-radius:999px;padding:3px 12px;margin-bottom:16px;position:relative;z-index:1}
.lead-card h2{font-weight:800;font-size:clamp(1.6rem,4.2vw,2.6rem);line-height:1.15;letter-spacing:-.015em;margin:0;max-width:26ch;position:relative;z-index:1}

/* Sections */
.desk{padding:20px 0 28px}
.desk h2{font-weight:800;font-size:1.05rem;color:var(--teal);margin:0 0 14px;padding-bottom:8px;border-bottom:2px solid var(--teal)}
.stories{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-left:1px solid var(--line)}
.story{padding:14px 20px 18px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
.story h3{margin:0;font-weight:700;font-size:1.12rem;line-height:1.3;color:var(--ink)}
.story.big{grid-column:span 2;grid-row:span 2;background:var(--teal-soft);display:flex;align-items:flex-end}
.story.big h3{font-weight:800;font-size:clamp(1.4rem,3vw,1.95rem);line-height:1.15;letter-spacing:-.01em;color:var(--navy)}

.aside{padding:12px 0 56px}
.aside-box{border:2px dashed var(--line);border-radius:14px;padding:18px 22px;display:flex;gap:16px;align-items:baseline;flex-wrap:wrap}
.aside-box span{font-weight:700;color:var(--muted);font-size:.92rem}
.aside-box h3{margin:0;font-weight:800;font-size:1.2rem;color:var(--navy)}

footer{background:var(--navy-deep);color:#b9bde0;padding:32px 0;text-align:center;font-weight:500}
footer a{color:#fff;font-weight:700}

@media (max-width:760px){
  .stories{grid-template-columns:1fr 1fr}
  .story.big{grid-row:auto}
}
@media (max-width:520px){
  body{font-size:1.1rem}
  .wrap{padding:0 18px}
  .top img{width:120px}
  .masthead{padding-top:32px}
  .dateline{font-size:.88rem}
  .lead-card{padding:28px 22px}
  .stories{grid-template-columns:1fr}
  .story.big{grid-column:auto}
  .story{padding:14px 16px 16px}
}
</style>
</head>
<body>

